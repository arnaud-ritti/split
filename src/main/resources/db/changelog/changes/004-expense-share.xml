<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="004-expense-share" author="split">
        <createTable tableName="expense_share">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_expense_share"/>
            </column>
            <column name="expense_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_expense_share_expense"
                             references="expense(id)"
                             deleteCascade="true"/>
            </column>
            <column name="member_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_expense_share_member"
                             references="group_member(id)"/>
            </column>
            <column name="amount" type="numeric(12, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="expense_share"
                             columnNames="expense_id, member_id"
                             constraintName="uq_expense_share_expense_member"/>
    </changeSet>

</databaseChangeLog>
